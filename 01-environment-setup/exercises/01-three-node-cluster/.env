
PROJECT_NAME=kafka-homelab
ENV_TAG=dev

# Confluent platform version
KAFKA_VERSION=7.8.0
CLUSTER_ID='33a278a3-4856-4046-b151-6b6044f43b1b'

# Replication factors, adjust according to node size
REPLICATION_FACTOR=3
MIN_INSYNC_REPLICAS=2

# Java Heap Size
KAFKA_HEAP_OPTS=-Xms512M -Xmx512M

# Networks and Ports
PORT_BROKER_1=9192
PORT_BROKER_2=9194
PORT_BROKER_1=9196

PORT_CONTROLLER_1=9193
PORT_CONTROLLER_2=9195
PORT_CONTROLLER_3=9197

# Observability Ports
PORT_PROMETHEUS=9190
PORT_GRAFANA=3000
PORT_KAFKA_UI=8080

# Internal JMX port
JMX_PORT=9101

# Paths and volumes
CONFIG_PATH=./configs

# Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# External JMX Access
PORT_JMX_1=9991
PORT_JMX_2=9992
PORT_JMX_3=9993

# Prometheus data Retention
PROM_RETENTION=30d